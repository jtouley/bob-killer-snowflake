#!/usr/bin/env bash
# coco-phase <prompt-file> <log-file>
# One CoCo build call (one phase or one fix) in the isolated clone, from labs/bob_killer/.
# The log always ends with "COCO_EXIT <code>", also on timeout or kill, so a Monitor wait always ends.
# The final agent message (with the COCO_RESULT block) is in <log>.last.md.
# Claude Code: run_in_background=true, timeout=7200000; wait with Monitor until COCO_EXIT is in the log.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; source "$here/coco-flags.sh"
prompt="${1:?usage: coco-phase <prompt-file> <log-file>}"; log="${2:?usage}"
lock="$COCO_CLONE.lock"; pgid=""; code=99

mkdir "$lock" 2>/dev/null || { echo "another CoCo call holds $lock" >&2; exit 3; }   # lock first, then touch the log
finish() {
  [[ -n "$pgid" ]] && kill -TERM -- "-$pgid" 2>/dev/null   # always: no CoCo child outlives the call
  echo "COCO_EXIT $code" >> "$log"
  rmdir "$lock" 2>/dev/null
}
die() { echo "COCO_ERROR $1" >> "$log"; code="$2"; exit "$code"; }
mkdir -p "$(dirname "$log")"; : > "$log"; rm -f "$log.last.md"
trap finish EXIT
trap 'code=143; exit 143' TERM INT HUP

[[ -f "$prompt" ]] || die "no prompt file: $prompt" 2
[[ -d "$COCO_CLONE/labs/bob_killer" ]] || die "no CoCo clone at $COCO_CLONE (run tools/coco-clone)" 2
command -v "$COCO_BIN" >/dev/null || die "$COCO_BIN not found" 2
have="$("$COCO_BIN" --version 2>/dev/null | head -1)"
ev="$(ls -1 "$here/.."/.context/evidence/coco_cli_*.txt 2>/dev/null | tail -1)"
[[ -n "$ev" ]] && grep -qxF "$have" "$ev" \
  || die "CoCo version '$have' is not in the newest evidence file ($ev): run tools/record-cli-evidence and review the flags" 4

echo "COCO_START $(date -u +%Y-%m-%dT%H:%M:%SZ) $have prompt=$prompt" >> "$log"
echo "COCO_HEAD $(git -c core.fsmonitor=false -C "$COCO_CLONE" rev-parse HEAD)" >> "$log"

set -m   # cortex gets its own process group (pgid = its pid), so one kill reaches all its children
"$COCO_BIN" exec -c "$COCO_CONNECTION" -w "$COCO_CLONE/labs/bob_killer" "${COCO_FLAGS[@]}" \
  --file "$prompt" -o "$log.last.md" >> "$log" 2>&1 </dev/null &
pgid=$!
set +m
deadline=$(( $(date +%s) + COCO_TIMEOUT_S ))
while kill -0 "$pgid" 2>/dev/null; do
  if (( $(date +%s) >= deadline )); then
    echo "COCO_ERROR timeout after ${COCO_TIMEOUT_S}s" >> "$log"; kill -TERM -- "-$pgid" 2>/dev/null; code=124; exit 124
  fi
  sleep 2
done
wait "$pgid"; code=$?
exit "$code"
