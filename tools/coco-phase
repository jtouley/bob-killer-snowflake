#!/usr/bin/env bash
# coco-phase <prompt-file> <log-file>
# Run one CoCo build call (one phase or one fix) in the CoCo worktree, from labs/bob_killer/.
# Claude Code starts this in the background and waits with Monitor until the log has COCO_EXIT.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=coco-flags.sh
source "$here/coco-flags.sh"

prompt="${1:?usage: coco-phase <prompt-file> <log-file>}"
log="${2:?usage: coco-phase <prompt-file> <log-file>}"
[[ -f "$prompt" ]] || { echo "no prompt file: $prompt" >&2; exit 2; }
[[ -d "$COCO_WORKTREE/labs/bob_killer" ]] || { echo "no CoCo worktree at $COCO_WORKTREE (run tools/coco-worktree)" >&2; exit 2; }
command -v cortex >/dev/null || { echo "cortex not on PATH" >&2; exit 2; }

mkdir -p "$(dirname "$log")"
{
  echo "COCO_START $(date -u +%Y-%m-%dT%H:%M:%SZ) $(cortex --version 2>/dev/null) prompt=$prompt"
  echo "COCO_HEAD $(git -C "$COCO_WORKTREE" rev-parse HEAD) branch=$(git -C "$COCO_WORKTREE" branch --show-current)"
} > "$log"

set +e
cortex exec -c "$COCO_CONNECTION" -w "$COCO_WORKTREE/labs/bob_killer" "${COCO_FLAGS[@]}" \
  --file "$prompt" -o "$log.last.md" >> "$log" 2>&1 </dev/null
code=$?
set -e
echo "COCO_EXIT $code" >> "$log"
exit "$code"
