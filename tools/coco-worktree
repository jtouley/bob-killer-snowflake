#!/usr/bin/env bash
# coco-worktree <run-branch> : make the isolated CoCo worktree on branch coco/<run-branch>.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$here/coco-flags.sh"
run="${1:?usage: coco-worktree <run-branch>}"
if [[ -d "$COCO_WORKTREE" ]]; then
  echo "exists: $COCO_WORKTREE ($(git -C "$COCO_WORKTREE" branch --show-current))"; exit 0
fi
git worktree add "$COCO_WORKTREE" -b "coco/$run" "$run"
echo "CoCo worktree: $COCO_WORKTREE on coco/$run"
