#!/usr/bin/env bash
# smoke-test : check the bob_killer connection with the Snowflake CLI and with CoCo's real flags.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; source "$here/coco-flags.sh"
root="$(git rev-parse --show-toplevel)"
out="$root/.context/evidence/smoke_$(date -u +%Y%m%dT%H%M%SZ).txt"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
{
  echo "=== snow connection test"; (cd "$root" && uv run snow connection test -c "$COCO_CONNECTION")
  echo "=== cortex exec (real flags)"
  cortex exec -c "$COCO_CONNECTION" -w "$tmp" "${COCO_FLAGS[@]}" --max-turns 5 \
    "Run SELECT CURRENT_USER(), CURRENT_ROLE(), CURRENT_WAREHOUSE(), CURRENT_VERSION(); print the result and stop." </dev/null
} 2>&1 | tee "$out"
