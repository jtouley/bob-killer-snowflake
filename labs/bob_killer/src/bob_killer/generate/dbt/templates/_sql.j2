[# Partials shared by every model template. #]
[% macro header(model, depends=()) %]
-- [[ model ]]: generated by bob-killer from the Workbook IR. Do not edit.
[% for d in depends %]
-- depends_on: {{ ref([[ d | sql ]]) }}
[% endfor %]
[% endmacro %]

[% macro cell_select(sheet, row, col, node_id, value) -%]
SELECT [[ sheet ]] AS [[ ident('sheet') ]], [[ row ]] AS [[ ident('row') ]], [[ col ]] AS [[ ident('col') ]], [[ node_id ]] AS [[ ident('node_id') ]], [[ value ]] AS [[ ident('value') ]]
[%- endmacro %]

[% macro cell_columns() -%]
[[ ident('sheet') ]], [[ ident('row') ]], [[ ident('col') ]], [[ ident('node_id') ]], [[ ident('value') ]]
[%- endmacro %]

[% macro union_all(items) %]
[% for item in items %]
[% if not loop.first %]
UNION ALL
[% endif %]
[[ caller(item) ]]
[% endfor %]
[% endmacro %]
